{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "notita",
  "version": "0.1.1",
  "identifier": "com.notita.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "notita",
        "url": "index.html",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "center": true,
        "decorations": true,
        "resizable": true,
        "dragDropEnabled": false,
        "visible": true
      },
      {
        "label": "quick-capture",
        "title": "Quick note",
        "url": "quick-capture.html",
        "width": 560,
        "height": 150,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false,
        "focus": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDQ4OTIyODUyMkE1MUUzOUIKUldTYjQxRXFVaWlTU0xFeFAvakgzRVZ4dmNhVVBQYXovS0VuenNUZU1VOFpvbTBVWlBOT0t5eUIK",
      "endpoints": [
        "https://github.com/Gxnza48/notita/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
